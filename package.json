{
  "name": "ui-behavior-coverage",
  "version": "0.1.0-alpha.0",
  "description": "Behavioral verification coverage for React and Material UI component tests.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "ubc": "dist/src/cli/index.js",
    "ui-behavior-coverage": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build && node --test dist/tests/*.test.js",
    "test": "npm run test:unit && npm run consumer:smoke",
    "smoke": "npm run build && node dist/src/cli/index.js analyze --component tests/fixtures/SaveButton.tsx --test tests/fixtures/SaveButton.weak.test.tsx",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "release:check": "npm run check && npm test && npm run pack:check",
    "ci": "npm run check && npm test && npm run pack:check"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "keywords": [
    "testing",
    "react",
    "coverage",
    "behavioral-testing",
    "testing-library",
    "vitest",
    "jest",
    "material-ui",
    "mui",
    "test-quality",
    "weak-oracle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapniyogi/ui-behavior-coverage.git"
  },
  "bugs": {
    "url": "https://github.com/sapniyogi/ui-behavior-coverage/issues"
  },
  "homepage": "https://github.com/sapniyogi/ui-behavior-coverage#readme"
}
